# KrishiMind SustainAI - Root Environment Configuration
# 
# This file documents all environment variables needed for the complete system.
# Copy to appropriate locations (.env files) with actual values.
# 
# DO NOT commit actual .env files with secrets - use .env.local for development

# ============================================================================
# BACKEND (FastAPI) - For Render.com or local development
# ============================================================================

# Python version for deployment
# Render.com setting (configure in render.yaml or Render dashboard)
# Recommended: 3.11.0 or 3.12.0
PYTHON_VERSION=3.11.0

# ============================================================================
# FRONTEND (Next.js) - For Vercel or local development
# Located in: frontend/.env.local (development) and frontend/.env.production (production)
# ============================================================================

# Backend API endpoint
# Development: http://127.0.0.1:8000 (local FastAPI server)
# Production: https://your-render-api-url.onrender.com
# Render example: https://krishimind-api.onrender.com
BACKEND_URL=http://127.0.0.1:8000

# ============================================================================
# OPTIONAL: AWS/Cloud Integrations (if using Lambda or S3)
# ============================================================================

# AWS S3 Configuration (for model artifacts or data storage)
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=krishimind-models
# AWS_ACCESS_KEY_ID=your-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-here

# AWS Lambda Configuration (for serverless inference)
# LAMBDA_FUNCTION_NAME=krishimind-predict
# LAMBDA_REGION=ap-south-1

# ============================================================================
# OPTIONAL: Database Configuration (if implementing persistence)
# ============================================================================

# DATABASE_URL=postgresql://user:password@localhost/krishimind_db
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/krishimind

# ============================================================================
# OPTIONAL: Logging and Monitoring
# ============================================================================

# LOG_LEVEL=INFO
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
