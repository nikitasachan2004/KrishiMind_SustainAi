# KrishiMind SustainAI Frontend - Environment Configuration
# 
# DEVELOPMENT: Copy this to .env.local with development values
# PRODUCTION: Configure environment variables in Vercel dashboard
# 
# Reference: .env.local (development) and .env.production (production)

# ============================================================================
# API Configuration
# ============================================================================

# Backend API URL - determines where the frontend sends predictions
# 
# Development: Use your local FastAPI server
#   BACKEND_URL=http://127.0.0.1:8000
# 
# Production: Use your deployed API (Render.com example)
#   BACKEND_URL=https://krishimind-api.onrender.com
#
# Important: Ensure the backend URL is accessible from the browser/client
# If using Render free tier, verify the API server doesn't auto-spin-down

BACKEND_URL=http://127.0.0.1:8000

# ============================================================================
# Next.js/Vercel Configuration (usually handled by Next.js automatically)
# ============================================================================

# NODE_ENV=development
# NEXT_PUBLIC_API_URL=${BACKEND_URL}  # If needed for client-side access
